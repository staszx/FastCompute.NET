<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>AiImageForensics.ImageSharp</PackageId>
    <Title>AiImageForensics.ImageSharp</Title>
    <Description>ImageSharp decoding and encoding integration for AiImageForensics.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiImageForensics\AiImageForensics.csproj" />
    <ProjectReference Include="..\FastCompute.ImageProcessing\FastCompute.ImageProcessing.csproj" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

</Project>
