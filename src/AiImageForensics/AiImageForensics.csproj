<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>AiImageForensics</PackageId>
    <Title>AiImageForensics</Title>
    <Description>Deterministic image-forensics analysis powered by FastCompute.NET.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FastCompute\FastCompute.csproj" />
    <ProjectReference Include="..\FastCompute.ImageProcessing\FastCompute.ImageProcessing.csproj" />
  </ItemGroup>

</Project>
