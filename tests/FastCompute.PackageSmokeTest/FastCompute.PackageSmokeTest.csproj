<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <FastComputePackageVersion Condition="'$(FastComputePackageVersion)' == ''">0.7.0</FastComputePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastCompute" Version="$(FastComputePackageVersion)" />
  </ItemGroup>

</Project>
